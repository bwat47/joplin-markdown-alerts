{
    "name": "joplin-plugin-markdown-alerts",
    "version": "1.7.4",
    "scripts": {
        "dist": "npm run typecheck && joplin-plugin-scripts build",
        "prepare": "npm run dist",
        "updateVersion": "joplin-plugin-scripts update-version",
        "updateApi": "joplin-plugin-scripts update-api",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest --passWithNoTests",
        "knip": "knip",
        "typecheck": "tsc --noEmit"
    },
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "keywords": [
        "joplin-plugin"
    ],
    "files": [
        "publish"
    ],
    "devDependencies": {
        "@bwat47/joplin-plugin-scripts": "^1.6.0",
        "@codemirror/autocomplete": "6.20.1",
        "@codemirror/lang-markdown": "6.5.0",
        "@codemirror/language": "6.12.3",
        "@codemirror/state": "6.7.1",
        "@codemirror/view": "6.43.14",
        "@eslint/js": "^10.0.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@lezer/common": "1.5.0",
        "@lezer/markdown": "1.6.3",
        "@types/markdown-it": "^14.1.2",
        "@types/node": "^24.13.2",
        "@vitest/eslint-plugin": "^1.6.28",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.18.0",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-tsdoc": "^0.5.4",
        "globals": "^17.7.0",
        "jsdom": "^31.0.0",
        "knip": "^6.44.1",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "markdown-it": "^14.1.1",
        "markdown-it-github-alerts": "^1.0.1"
    },
    "overrides": {
        "eslint-plugin-tsdoc": {
            "@typescript-eslint/utils": "8.72.1"
        }
    }
}
